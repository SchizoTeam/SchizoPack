models/players/hoverboard_if/hoverboard2
{
	qer_editorimage models/players/hoverboard_if/hoverboard2.jpg
	q3map_lightimage models/players/hoverboard_if/hoverboard2_glow.jpg
	q3map_shadeangle	90
	q3map_surfacelight 500
	q3map_backSplash 0.5 8
	q3map_nonplanar
    {
        map $lightmap
    }
    {
        map models/players/hoverboard_if/hoverboard2
        blendFunc GL_DST_COLOR GL_ZERO
    }
    {
        map models/players/hoverboard_if/hoverboard2_glow
        blendFunc GL_ONE GL_ONE
        glow
    }
}

