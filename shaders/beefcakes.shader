models/players/steroidian/body
{
	cull	disable
	{
		map models/players/steroidian/body
		blendFunc GL_ONE GL_ZERO
		rgbGen lightingDiffuse
	}
	{
		map gfx/models/players/steroidian/body-a
		blendFunc GL_SRC_ALPHA GL_ONE
       		detail
		alphaGen lightingSpecular
	}
	{
		map gfx/models/players/steroidian/body-glow
		blendFunc GL_ONE GL_ONE
		glow
		rgbGen identity
	}
	{
		map gfx/models/players/swoledor/body-spec
		blendFunc GL_SRC_ALPHA GL_ONE
		alphaGen lightingSpecular
	}
}

