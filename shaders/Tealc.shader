models/players/Tealc/serpent
{
	q3map_nolightmap
	cull	disable
    {
        map models/players/Tealc/serpent
        rgbGen lightingDiffuse
    }
    {
        map models/players/Tealc/serpent_Spec
        blendFunc GL_SRC_ALPHA GL_ONE
        detail
        alphaGen lightingSpecular
    }
    {
        map models/players/Tealc/serpent_Spec_Glow
        blendFunc GL_ONE GL_ONE
        glow
    }
}

