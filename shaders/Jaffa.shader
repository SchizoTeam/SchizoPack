models/players/Anubis/helmut
{
	q3map_nolightmap
	cull	disable
    {
        map models/players/Anubis/helmut
        rgbGen lightingDiffuse
    }
    {
        map models/players/Anubis/helmut_Spec
        blendFunc GL_SRC_ALPHA GL_ONE
        detail
        alphaGen lightingSpecular
    }
    {
        map models/players/Anubis/helmut_Spec_Glow
        blendFunc GL_ONE GL_ONE
        glow
    }
}

