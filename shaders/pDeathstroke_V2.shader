models/players/pDeathstroke_v2/body
{
    {
        map models/players/pDeathstroke_v2/body
        rgbGen lightingDiffuse
    }
    {
        map models/players/pDeathstroke_v2/body_spec
        blendFunc GL_SRC_ALPHA GL_ONE
        detail
        alphaGen lightingSpecular
    }
}

