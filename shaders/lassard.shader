models/players/lassard/lassardshoe
{
    {
        map models/players/lassard/lassardshoe_shader
        depthWrite
        rgbGen lightingDiffuse
    }
    {
        map models/players/lassard/lassardshoe
        blendFunc GL_SRC_ALPHA GL_ONE
        detail
        alphaGen lightingSpecular
    }
}


models/players/lassard/lassard
{
{
        map models/players/lassard/torsoalfa
        tcGen environment
	rgbGen identity
    }
    {
        map models/players/lassard/lassard
        blendfunc blend
        rgbGen lightingDiffuse
    }
    
}

