models/players/jedi_caex/hat
{
	cull	disable
    {
        map models/players/jedi_caex/hat
        alphaFunc GE128
        depthWrite
        rgbGen lightingDiffuse
    }
    {
        map models/players/jedi_caex/hat
        blendFunc GL_SRC_ALPHA GL_ONE
        detail
        alphaGen lightingSpecular
    }
}

