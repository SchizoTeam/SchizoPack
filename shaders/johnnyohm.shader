models/players/johnnyohm/johnny_d
{
    {
        map models/players/johnnyohm/johnny_d
        blendFunc GL_ONE GL_ZERO
        rgbGen lightingDiffuse
    }
    {
        map models/players/johnnyohm/johnny_d_spec
        blendFunc GL_SRC_ALPHA GL_ONE
        detail
       	alphaGen lightingSpecular
    }
    {
        map models/players/johnnyohm/johnny_d_glow
        blendFunc GL_ONE GL_ONE
        glow
    }
}

