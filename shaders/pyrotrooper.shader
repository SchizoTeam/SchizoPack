models/players/pyrotrooper/torso_arms
{
    {
        map models/players/pyrotrooper/torso_arms
        blendFunc GL_ONE GL_ZERO
        rgbGen lightingDiffuse
    }
    {
        map models/players/pyrotrooper/torso_arms
        blendFunc GL_SRC_ALPHA GL_ONE
        glow
        detail
        alphaGen lightingSpecular
    }
    {
        map models/players/pyrotrooper/torso_arms_glow
        blendFunc GL_ONE GL_ONE
        glow
        rgbGen identity
    }
}

