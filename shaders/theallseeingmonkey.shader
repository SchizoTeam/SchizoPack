models/players/theallseeingmonkey/monkey
{
    cull twosided
    {
        map models/players/theallseeingmonkey/monkey
        blendFunc GL_ONE GL_ZERO
        rgbGen lightingDiffuse
    }
    {
        map models/players/theallseeingmonkey/monkey_glw
        blendFunc GL_ONE GL_ONE
        rgbGen identity
		glow
    }
    {
        map models/players/theallseeingmonkey/monkey_s
        blendFunc GL_SRC_ALPHA GL_ONE
        alphaGen lightingSpecular
    }
}

